<Sysmon schemaversion="4.90">
  <!--
  title: Domain controller DriverLoad exclude rules
  volume: unmeasured
  source: migrated from examples/domain-controller-config.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="driver_load/dc_exclude" groupRelation="or">
      <DriverLoad onmatch="exclude">
        <!-- AND, not OR: excluding on Signed alone would hide signed-but-vulnerable drivers (BYOVD) -->
        <Rule groupRelation="and">
          <Signed condition="is">true</Signed>
          <Signature condition="is">Microsoft Windows</Signature>
        </Rule>
      </DriverLoad>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
