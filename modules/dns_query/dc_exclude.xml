<Sysmon schemaversion="4.90">
  <!--
  title: Domain controller DnsQuery exclude rules
  volume: unmeasured
  source: migrated from examples/domain-controller-config.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="dns_query/dc_exclude" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <!-- Internal domain -->
        <QueryName condition="end with">.local</QueryName>
        <!-- Microsoft -->
        <QueryName condition="is any">microsoft.com;windows.com</QueryName>
        <QueryName condition="end with">.microsoft.com</QueryName>
        <QueryName condition="end with">.windows.com</QueryName>
        <!-- AD forest trusts: add your trusted forest domains here, anchored like the lines above -->
      </DnsQuery>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
