<Sysmon schemaversion="4.90">
  <!--
  title: T1047 WMI execution and persistence: NetworkConnect include
  techniques: T1047
  volume: unmeasured
  source: migrated from configurations/modules/techniques/T1047_wmi_execution.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="network_connect/t1047_wmi" groupRelation="or">
      <NetworkConnect onmatch="include">
        <!-- WMIC network connections (typically port 135 RPC) -->
        <Rule groupRelation="and">
          <Image condition="end with">\wmic.exe</Image>
          <Initiated condition="is">true</Initiated>
        </Rule>
        <!-- WMI Provider Host remote connections -->
        <Rule groupRelation="and">
          <Image condition="end with">\wmiprvse.exe</Image>
          <DestinationPort condition="is">135</DestinationPort>
        </Rule>
      </NetworkConnect>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
