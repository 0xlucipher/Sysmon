<Sysmon schemaversion="4.90">
  <!--
  title: Domain controller NetworkConnect exclude rules
  volume: unmeasured
  source: migrated from examples/domain-controller-config.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="network_connect/dc_exclude" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <!-- Localhost -->
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
        <!-- Legitimate AD replication (customize for your DCs) -->
        <!--
        <Rule groupRelation="and">
          <Image condition="is">C:\Windows\System32\svchost.exe</Image>
          <DestinationIp condition="is">10.0.1.10</DestinationIp>
        </Rule>
        -->
      </NetworkConnect>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
