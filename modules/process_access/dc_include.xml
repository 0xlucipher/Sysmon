<Sysmon schemaversion="4.90">
  <!--
  title: Domain controller ProcessAccess include rules
  volume: unmeasured
  source: migrated from examples/domain-controller-config.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="process_access/dc_include" groupRelation="or">
      <ProcessAccess onmatch="include">
        <!-- LSASS (CRITICAL - most targeted on DCs) -->
        <TargetImage condition="end with">\lsass.exe</TargetImage>
        <!-- Other critical processes -->
        <TargetImage condition="end with">\winlogon.exe</TargetImage>
        <TargetImage condition="end with">\services.exe</TargetImage>
        <TargetImage condition="end with">\csrss.exe</TargetImage>
        <!-- Directory Services processes -->
        <TargetImage condition="end with">\lsaiso.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
