<Sysmon schemaversion="4.90">
  <!--
    title: LSA, security packages and WDigest credential caching
    techniques: T1547.005, T1003.001
    volume: unmeasured
    source: migrated from configurations/sysmon-base.xml (phase 2), regrouped by technique in phase 3
    notes: WDigest UseLogonCredential=1 makes LSASS keep plaintext passwords.
  -->
  <EventFiltering>
    <RuleGroup name="registry_event/general_credential_config" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains">\SYSTEM\CurrentControlSet\Control\Lsa</TargetObject>
        <TargetObject condition="contains">\SYSTEM\CurrentControlSet\Control\SecurityProviders</TargetObject>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
