<Sysmon schemaversion="4.90">
  <!--
  title: Domain controller RegistryEvent exclude rules
  volume: unmeasured
  source: migrated from examples/domain-controller-config.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="registry_event/dc_exclude" groupRelation="or">
      <RegistryEvent onmatch="exclude">
        <!-- Minimal exclusions on DCs -->
        <TargetObject condition="contains">\MuiCache\</TargetObject>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
