<Sysmon schemaversion="4.90">
  <!--
  title: T1003 credential dumping: RegistryEvent include
  techniques: T1003.005
  volume: unmeasured
  source: migrated from configurations/modules/techniques/T1003_credential_dumping.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="registry_event/t1003_credential_dumping" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- from RuleGroup T1003.005_Cached_Creds -->
        <TargetObject condition="contains">\SECURITY\Cache</TargetObject>
        <TargetObject condition="contains">\Control\Lsa\MSV1_0</TargetObject>
        <!-- from RuleGroup T1003_WDigest_Enable -->
        <Rule groupRelation="and">
          <TargetObject condition="contains">\System\CurrentControlSet\Control\SecurityProviders\WDigest\UseLogonCredential</TargetObject>
          <Details condition="is">DWORD (0x00000001)</Details>
        </Rule>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
