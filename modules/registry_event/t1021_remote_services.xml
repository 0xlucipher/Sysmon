<Sysmon schemaversion="4.90">
  <!--
  title: T1021 remote services: RegistryEvent include
  techniques: T1021.002
  volume: unmeasured
  source: migrated from configurations/modules/techniques/T1021_remote_services.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="registry_event/t1021_remote_services" groupRelation="or">
      <RegistryEvent onmatch="include">
        <Rule groupRelation="and">
          <TargetObject condition="contains">\System\CurrentControlSet\Services\</TargetObject>
          <TargetObject condition="contains">\ImagePath</TargetObject>
          <Details condition="contains">\ADMIN$\</Details>
        </Rule>
        <Rule groupRelation="and">
          <TargetObject condition="contains">\System\CurrentControlSet\Services\</TargetObject>
          <TargetObject condition="contains">PSEXESVC</TargetObject>
        </Rule>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
