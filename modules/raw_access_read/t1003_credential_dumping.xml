<Sysmon schemaversion="4.90">
  <!--
  title: T1003 credential dumping: RawAccessRead include
  techniques: T1003.002
  sigma: db809f10-56ce-4420-8c86-d6a7d793c79c
  volume: unmeasured
  source: migrated from configurations/modules/techniques/T1003_credential_dumping.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="raw_access_read/t1003_credential_dumping" groupRelation="or">
      <RawAccessRead onmatch="include">
        <!-- SAM/SYSTEM hive access -->
        <Device condition="contains">\Device\HarddiskVolumeShadowCopy</Device>
      </RawAccessRead>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
