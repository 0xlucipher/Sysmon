<Sysmon schemaversion="4.90">
  <!--
  title: Domain controller RawAccessRead include rules
  volume: unmeasured
  source: migrated from examples/domain-controller-config.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="raw_access_read/dc_include" groupRelation="or">
      <RawAccessRead onmatch="include">
        <!-- Monitor ALL raw disk access on DCs -->
        <Image condition="begin with">C:\</Image>
      </RawAccessRead>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
