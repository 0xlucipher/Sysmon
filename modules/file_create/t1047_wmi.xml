<Sysmon schemaversion="4.90">
  <!--
  title: T1047 WMI execution and persistence: FileCreate include
  techniques: T1047
  volume: unmeasured
  source: migrated from configurations/modules/techniques/T1047_wmi_execution.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="file_create/t1047_wmi" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="end with">.mof</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
