<Sysmon schemaversion="4.90">
  <!--
  title: Noise: common third-party software FileCreate activity
  volume: unmeasured
  source: migrated from configurations/modules/exclusions/common_software.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="file_create/noise_common_software" groupRelation="or">
      <FileCreate onmatch="exclude">
        <!-- from RuleGroup Browsers_Exclude -->
        <!-- Chrome cache (extremely noisy) -->
        <TargetFilename condition="contains">\Google\Chrome\User Data\</TargetFilename>
        <!-- Firefox cache -->
        <TargetFilename condition="contains">\Mozilla\Firefox\Profiles\</TargetFilename>
        <!-- from RuleGroup Printing_Exclude -->
        <!-- Print spool files -->
        <TargetFilename condition="begin with">C:\Windows\System32\spool\PRINTERS\</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
