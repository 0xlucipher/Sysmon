<Sysmon schemaversion="4.90">
  <!--
  title: T1021 remote services: FileCreate include
  techniques: T1021
  volume: unmeasured
  source: migrated from configurations/modules/techniques/T1021_remote_services.xml
  status: migrated in phase 2; review in phase 3
-->
  <EventFiltering>
    <RuleGroup name="file_create/t1021_remote_services" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains">\C$\</TargetFilename>
        <TargetFilename condition="contains">\ADMIN$\</TargetFilename>
        <TargetFilename condition="contains">\IPC$\</TargetFilename>
      </FileCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
