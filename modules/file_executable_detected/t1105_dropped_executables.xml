<Sysmon schemaversion="4.90">
  <!--
    title: Executables written to Temp and Downloads
    techniques: T1105, T1204.002
    volume: unmeasured
    source: migrated from configurations/sysmon-base.xml (phase 2), regrouped by technique in phase 3
  -->
  <EventFiltering>
    <RuleGroup name="file_executable_detected/t1105_dropped_executables" groupRelation="or">
      <FileExecutableDetected onmatch="include">
        <TargetFilename condition="begin with">C:\Windows\Temp\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Local\Temp\</TargetFilename>
        <TargetFilename condition="contains">\Downloads\</TargetFilename>
      </FileExecutableDetected>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
